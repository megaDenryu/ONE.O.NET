<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../OneONet.Domain/OneONet.Domain.csproj" />
    <ProjectReference Include="../OneONet.Application/OneONet.Application.csproj" />
    <ProjectReference Include="../OneONet.SpeechRecognition/OneONet.SpeechRecognition.csproj" />
    <ProjectReference Include="../OneONet.VoiceSynthesis/OneONet.VoiceSynthesis.csproj" />
    <ProjectReference Include="../OneONet.Persistence/OneONet.Persistence.csproj" />
    <ProjectReference Include="../OneONet.HostContracts/OneONet.HostContracts.csproj" />
    <ProjectReference Include="../OneONet.UI/OneONet.UI.csproj" />
  </ItemGroup>
</Project>
